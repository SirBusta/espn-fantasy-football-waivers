# Settings for running with Docker Compose or `docker run --env-file .env`.
# (On Unraid, fill these in on the template's form instead.)
# Don't put quotes around values.

# ---- ESPN league -----------------------------------------------------------
# The number after leagueId= in your league's URL on fantasy.espn.com
LEAGUE_ID=123456
# Only needed for PRIVATE leagues: the espn_s2 and SWID cookies from espn.com
# (see README). Leave blank for public leagues.
ESPN_S2=
SWID=
# Season year. Blank follows the league's latest season automatically.
SEASON=

# ---- What to send ----------------------------------------------------------
# WAIVER (waiver claims). Add any of FA (free-agent pickups), TRADE and
# DROP (drops with no pickup), comma separated.
NOTIFY_TYPES=WAIVER

# ---- When to check ---------------------------------------------------------
# auto: check AUTO_DELAY_MINUTES after each of the league's waiver runs, using
#       the schedule ESPN reports (recommended)
# HH:MM,...: fixed 24-hour times in TZ, e.g. 09:15 (on CHECK_DAYS)
# interval: every POLL_MINUTES
CHECK_TIMES=auto
AUTO_DELAY_MINUTES=15
# Days for fixed CHECK_TIMES, e.g. Wed,Thu,Fri,Sat,Sun. Blank means every day.
CHECK_DAYS=
POLL_MINUTES=15
# Email "No waiver claims today" after a waiver run with nothing new (not with
# interval). Paused automatically between seasons.
NOTIFY_WHEN_EMPTY=true
# Time zone for CHECK_TIMES and for times shown in emails
TZ=America/New_York

# ---- Email (SMTP) ----------------------------------------------------------
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification) and type it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=you@gmail.com
# One or more addresses, comma separated, no spaces
EMAIL_TO=you@gmail.com
# true sends a test email each time the container starts
SEND_TEST_EMAIL=false

# ---- Less common -----------------------------------------------------------
# Email the existing recent activity the very first time it starts
SEND_ON_FIRST_RUN=false
# Owner of the data folder (Unraid default nobody:users)
PUID=99
PGID=100
